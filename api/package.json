{
  "name": "service-app-mowgosnowgo-com",
  "version": "1.0.0",
  "description": "The MowGoSnowGO App Backend",
  "author": "Dragos Rotaru",
  "license": "UNLICENSED",
  "main": "index.js",
  "scripts": {
    "setup": "npm run setup:install && npm run setup:db",
    "setup:install": "npm install",
    "setup:db": "npm run db:migrate && npm run db:seed",
    "db:migrate": "npx sequelize db:migrate --env database",
    "db:seed": "npx sequelize db:seed:all --env database",
    "start": "cd bin && node index.js",
    "build": "rm -r bin && npx babel-cli src -d bin",
    "dev": "DEBUG=main,user,service nodemon src/index.js --exec babel-node --presets es2015,stage-2",
    "prod": "pm2 startOrReload package.json --env production",
    "deploy": "npm run build && npm run prod",
    "flow": "flow",
    "flow:check": "flow check"
  },
  "apps": [
    {
      "name": "service-app-mowgosnowgo-com",
      "script": "bin/index.js",
      "args": [],
      "watch": false,
      "merge_logs": true,
      "node_args": "--harmony",
      "instances": 0,
      "exec_mode": "cluster",
      "max_memory_restart": "500M",
      "env": {
        "NODE_ENV": "development"
      },
      "env_production": {
        "NODE_ENV": "production",
        "DEBUG": "main,user,service",
        "PORT": 6666,
        "EMAIL_ADDRESS": "app@mowgosnowgo.com",
        "STRIPE_PUBLIC_KEY": "",
        "SQL_USERNAME": "service-app-mowgosnowgo-com",
        "SQL_PASSWORD": "",
        "SQL_DATABASE": "service-app-mowgosnowgo-com-production"
      }
    }
  ],
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.3",
    "babel-eslint": "^8.2.3",
    "babel-preset-env": "^1.6.1",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-flow": "^6.23.0",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-2": "^6.24.1",
    "eslint": "^4.19.1",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-plugin-babel": "^5.1.0",
    "eslint-plugin-import": "^2.11.0",
    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-react": "^7.7.0",
    "flow-bin": "^0.71.0",
    "flow-typed": "^2.4.0",
    "nodemon": "^1.18.3"
  },
  "dependencies": {
    "@sendgrid/mail": "^6.2.1",
    "apollo-cache-inmemory": "^1.1.5",
    "apollo-client": "^2.2.0",
    "apollo-link": "^1.2.2",
    "apollo-link-error": "^1.0.9",
    "apollo-link-http": "^1.3.2",
    "apollo-link-state": "^0.3.1",
    "axios": "^0.18.0",
    "babel-polyfill": "^6.26.0",
    "bcrypt": "^2.0.0",
    "body-parser": "^1.18.2",
    "cookie-parser": "^1.4.3",
    "cors": "^2.8.4",
    "debug": "^3.1.0",
    "dotenv": "^5.0.0",
    "express": "^5.0.0-alpha.2",
    "express-graphql": "^0.6.11",
    "graphql": "^0.12.3",
    "graphql-tag": "^2.4.2",
    "helmet": "^3.13.0",
    "jsonwebtoken": "^8.1.0",
    "moment": "^2.22.1",
    "morgan": "^1.9.0",
    "multer": "^1.3.0",
    "mysql2": "1.5.3",
    "pg": "^7.4.1",
    "sequelize": "4.37.6",
    "sequelize-cli": "4.0.0",
    "stripe": "^5.9.0"
  }
}
